@{ ViewData["Title"] = "Error"; }
<div class="container py-5 text-center" style="max-width:560px">
    <i class="bi bi-exclamation-triangle" style="font-size:3rem;color:var(--coral)"></i>
    <h1 class="h3 mt-2">The server hit an unexpected error.</h1>
    <p class="text-muted">The problem has been logged. Try again, and if it keeps happening quote reference <code>@ViewBag.RequestId</code> to support.</p>
    <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Back to the store</a>
</div>
