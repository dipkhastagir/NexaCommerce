@{ ViewData["Title"] = "Terms"; }
<div class="container py-4" style="max-width:780px">
    <h1 class="mb-3">Terms of sale</h1>
    <ol class="lh-lg">
        <li>Prices include VAT and are shown in Bangladeshi taka.</li>
        <li>An order is confirmed once stock has been reserved for it. If an item becomes unavailable we will contact you before shipping.</li>
        <li>Delivery is free for orders at or above the free-delivery threshold shown at checkout; otherwise a flat delivery fee applies.</li>
        <li>Orders can be cancelled until they are processed. Delivered orders can be returned within 30 days in their original condition.</li>
        <li>Coupons cannot be combined, and each coupon has its own minimum order value and expiry date.</li>
        <li>Orders that our risk checks flag may be held for a short manual review before dispatch.</li>
    </ol>
</div>
