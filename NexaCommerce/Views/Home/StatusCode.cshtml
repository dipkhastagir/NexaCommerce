@{
    int code = ViewBag.Code ?? 404;
    ViewData["Title"] = code == 404 ? "Page not found" : "Something went wrong";
}
<div class="container py-5 text-center" style="max-width:560px">
    <div class="display-font" style="font-size:5rem;font-weight:800;color:var(--violet)">@code</div>
    <h1 class="h3">@(code == 404 ? "We couldn't find that page." : code == 403 ? "You don't have access to this page." : "The request couldn't be completed.")</h1>
    <p class="text-muted">Check the address, or head back to the store and search for what you need.</p>
    <a class="btn btn-primary mt-2" asp-controller="Home" asp-action="Index">Go to the home page</a>
</div>
