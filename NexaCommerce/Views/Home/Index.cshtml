@model HomeVm
@{
    ViewData["Title"] = "Everyday goods, stocked by data";
    var pulse = Model.BestSellers.Take(5).ToList();
    var maxSold = pulse.Count > 0 ? Math.Max(1, pulse.Max(p => p.UnitsSold)) : 1;
}
<section class="hero">
    <div class="container">
        <div class="row g-5 align-items-center">
            <div class="col-lg-6">
                <h1>Shop what's actually on the shelf.</h1>
                <p class="lead mt-3">Every stock count on this site is live, and our restocking runs on demand forecasts &mdash; so the item you add to your bag is the item that ships.</p>
                <div class="d-flex gap-2 mt-4 flex-wrap">
                    <a class="btn btn-primary btn-lg px-4" asp-controller="Shop" asp-action="Index">Browse products</a>
                    <a class="btn btn-ghost btn-lg px-4" asp-controller="Shop" asp-action="Deals">See today's deals</a>
                </div>
                <div class="d-flex gap-4 mt-4 small text-muted">
                    <span><i class="bi bi-truck me-1"></i>Free delivery over @Fmt.Money(2000)</span>
                    <span><i class="bi bi-arrow-counterclockwise me-1"></i>30-day returns</span>
                    <span><i class="bi bi-cash-coin me-1"></i>Cash on delivery</span>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="pulse-board">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h3>Selling fastest right now</h3>
                        <span class="small" style="color:#A9A6CC">units sold / in stock</span>
                    </div>
                    @foreach (var p in pulse)
                    {
                        <a class="pulse-row" asp-controller="Shop" asp-action="Details" asp-route-id="@p.ProductId">
                            <span class="mini-thumb" style="background:@Visual.Tint(p.CategoryId);color:@Visual.Ink(p.CategoryId)"><i class="bi @p.CategoryIcon"></i></span>
                            <span class="nm">@p.Name<small>@Fmt.Money(p.EffectivePrice)</small></span>
                            <span class="pulse-bar" aria-hidden="true"><span style="width:@((int)(100.0 * p.UnitsSold / maxSold))%"></span></span>
                            <span class="tabular small text-end" style="min-width:64px;color:#fff">@p.UnitsSold / @p.StockQuantity</span>
                        </a>
                    }
                    @if (Model.TopPairs.Any())
                    {
                        <div class="mt-3 small" style="color:#A9A6CC">Customers who buy one usually buy the other</div>
                        @foreach (var r in Model.TopPairs)
                        {
                            <div class="pair-chip"><i class="bi bi-link-45deg"></i><span class="text-truncate">@r.AntecedentName + @r.ConsequentName</span><span class="lift">@r.Lift.ToString("0.0")&times; more likely</span></div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</section>

<section class="section pt-0">
    <div class="container">
        <div class="section-head"><h2>Shop by category</h2></div>
        <div class="row g-3">
            @foreach (var c in Model.Categories)
            {
                <div class="col-6 col-md-4 col-lg-3">
                    <a class="cat-tile" asp-controller="Shop" asp-action="Index" asp-route-category="@c.CategoryId">
                        <span class="ic" style="background:@Visual.Tint(c.CategoryId);color:@Visual.Ink(c.CategoryId)"><i class="bi @c.Icon"></i></span>
                        <span><b>@c.Name</b><small>@c.ProductCount products</small></span>
                    </a>
                </div>
            }
        </div>
    </div>
</section>

@if (Model.Featured.Any())
{
    <section class="section">
        <div class="container">
            <div class="section-head"><h2>Picked for this season</h2><a asp-controller="Shop" asp-action="Index">View all</a></div>
            <div class="row g-3">
                @foreach (var p in Model.Featured)
                {
                    <div class="col-6 col-lg-3"><partial name="_ProductCard" model="p" /></div>
                }
            </div>
        </div>
    </section>
}

<section class="section">
    <div class="container">
        <div class="section-head"><h2>Best sellers</h2><a asp-controller="Shop" asp-action="Index" asp-route-sort="popular">See ranking</a></div>
        <div class="row g-3">
            @foreach (var p in Model.BestSellers)
            {
                <div class="col-6 col-md-4 col-lg-3"><partial name="_ProductCard" model="p" /></div>
            }
        </div>
    </div>
</section>

@if (Model.Deals.Any())
{
    <section class="section">
        <div class="container">
            <div class="panel" style="background:var(--violet-soft);border-color:#D9D1FF">
                <div class="section-head"><h2>Marked down this week</h2><a asp-controller="Shop" asp-action="Deals">All deals</a></div>
                <div class="row g-3">
                    @foreach (var p in Model.Deals)
                    {
                        <div class="col-6 col-lg-3"><partial name="_ProductCard" model="p" /></div>
                    }
                </div>
            </div>
        </div>
    </section>
}
