@{ ViewData["Title"] = "Check your e-mail"; string link = ViewBag.ResetLink; }
<div class="container auth-shell">
    <div class="auth-card">
        <div class="panel p-4">
            <h1 class="h3 mb-2">Check your e-mail</h1>
            <p class="text-muted">If an account exists for <b>@ViewBag.Email</b>, a reset link is on its way. It expires in 30 minutes and can be used once.</p>
            @if (!string.IsNullOrEmpty(link))
            {
                <div class="demo-creds">
                    <b><i class="bi bi-envelope-paper me-1"></i>Simulated outbox</b>
                    <p class="mb-2 mt-1">No mail server is configured in this build, so the message that would have been sent is shown here.</p>
                    <a class="btn btn-primary btn-sm" href="@link">Open reset link</a>
                </div>
            }
            <p class="small mt-3 mb-0"><a asp-action="Login">Back to sign in</a></p>
        </div>
    </div>
</div>
