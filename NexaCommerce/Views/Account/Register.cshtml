@model RegisterVm
@{ ViewData["Title"] = "Create account"; }
<div class="container auth-shell">
    <div class="auth-card">
        <div class="panel p-4">
            <h1 class="h3 mb-1">Create your account</h1>
            <p class="text-muted">Track orders, save addresses and get 10% off your first order.</p>
            <form asp-action="Register" method="post">
                <div asp-validation-summary="ModelOnly" class="flash flash-error mb-3"></div>
                <div class="mb-3"><label asp-for="FullName" class="form-label"></label><input asp-for="FullName" class="form-control" autocomplete="name" /><span asp-validation-for="FullName"></span></div>
                <div class="mb-3"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control" autocomplete="email" /><span asp-validation-for="Email"></span></div>
                <div class="mb-3"><label asp-for="Phone" class="form-label"></label><input asp-for="Phone" class="form-control" autocomplete="tel" placeholder="+880 17..." /><span asp-validation-for="Phone"></span></div>
                <div class="mb-3"><label asp-for="Password" class="form-label"></label><input asp-for="Password" class="form-control" autocomplete="new-password" /><span asp-validation-for="Password"></span><div class="small text-muted mt-1">At least 8 characters with a letter and a digit.</div></div>
                <div class="mb-3"><label asp-for="ConfirmPassword" class="form-label"></label><input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" /><span asp-validation-for="ConfirmPassword"></span></div>
                <button class="btn btn-primary w-100" type="submit">Create account</button>
            </form>
            <p class="text-center small mt-3 mb-0">Already registered? <a asp-action="Login">Sign in</a></p>
        </div>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
