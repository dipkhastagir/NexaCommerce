@model ResetPasswordVm
@{ ViewData["Title"] = "Choose a new password"; }
<div class="container auth-shell">
    <div class="auth-card">
        <div class="panel p-4">
            <h1 class="h3 mb-3">Choose a new password</h1>
            <form asp-action="ResetPassword" method="post">
                <input type="hidden" asp-for="Token" />
                <div class="mb-3"><label asp-for="NewPassword" class="form-label"></label><input asp-for="NewPassword" class="form-control" autocomplete="new-password" /><span asp-validation-for="NewPassword"></span></div>
                <div class="mb-3"><label asp-for="ConfirmPassword" class="form-label"></label><input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" /><span asp-validation-for="ConfirmPassword"></span></div>
                <button class="btn btn-primary w-100" type="submit">Save new password</button>
            </form>
        </div>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
