@model ForgotPasswordVm
@{ ViewData["Title"] = "Reset password"; }
<div class="container auth-shell">
    <div class="auth-card">
        <div class="panel p-4">
            <h1 class="h3 mb-1">Reset your password</h1>
            <p class="text-muted">Enter the e-mail on your account and we'll send a reset link that works once, for 30 minutes.</p>
            <form asp-action="ForgotPassword" method="post">
                <div class="mb-3"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control" autofocus /><span asp-validation-for="Email"></span></div>
                <button class="btn btn-primary w-100" type="submit">Send reset link</button>
            </form>
            <p class="text-center small mt-3 mb-0"><a asp-action="Login">Back to sign in</a></p>
        </div>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
