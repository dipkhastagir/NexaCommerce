@model LoginVm
@{ ViewData["Title"] = "Sign in"; }
<div class="container auth-shell">
    <div class="auth-card">
        <div class="panel p-4">
            <h1 class="h3 mb-1">Sign in</h1>
            <p class="text-muted">Welcome back. Use your e-mail and password.</p>
            <form asp-action="Login" method="post">
                <input type="hidden" asp-for="ReturnUrl" />
                <div asp-validation-summary="ModelOnly" class="flash flash-error mb-3"></div>
                <div class="mb-3"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control" autocomplete="username" autofocus /><span asp-validation-for="Email"></span></div>
                <div class="mb-2"><label asp-for="Password" class="form-label"></label><input asp-for="Password" class="form-control" autocomplete="current-password" /><span asp-validation-for="Password"></span></div>
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div class="form-check"><input asp-for="RememberMe" class="form-check-input" /><label asp-for="RememberMe" class="form-check-label small"></label></div>
                    <a class="small" asp-action="ForgotPassword">Forgot password?</a>
                </div>
                <button class="btn btn-primary w-100" type="submit">Sign in</button>
            </form>
            <p class="text-center small mt-3 mb-0">New here? <a asp-action="Register">Create an account</a></p>
        </div>
        <div class="demo-creds mt-3">
            <b>Demo accounts</b> (password in brackets)
            <div class="mt-1">Admin: <code>@("admin@nexacommerce.com")</code> (<code>@("Admin@123")</code>)</div>
            <div>Manager: <code>@("manager@nexacommerce.com")</code> (<code>@("Manager@123")</code>)</div>
            <div>Staff: <code>@("staff@nexacommerce.com")</code> (<code>@("Staff@123")</code>)</div>
            <div>Customer: <code>@("customer@nexacommerce.com")</code> (<code>@("Customer@123")</code>)</div>
        </div>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
