@inject NexaCommerce.Services.CartService Cart
@inject NexaCommerce.Services.CategoryService Categories
@{
    var cartCount = await Cart.CountAsync();
    var navCats = (await Categories.AllAsync(true)).Where(c => c.ParentCategoryId == null).ToList();
    var currentCat = Context.Request.Query["category"].ToString();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] | NexaCommerce</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,650;12..96,750;12..96,800&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Head", required: false)
</head>
<body>
    <div class="store-top py-1">
        <div class="container d-flex justify-content-between">
            <span><i class="bi bi-truck me-1"></i> Free delivery over @Fmt.Money(2000) across Bangladesh</span>
            <span class="d-none d-md-inline">
                @if (User.IsBackOffice())
                {
                    <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-speedometer2 me-1"></i>Back office</a>
                }
                else
                {
                    <a asp-controller="Home" asp-action="Contact">Help &amp; contact</a>
                }
            </span>
        </div>
    </div>
    <header class="store-nav">
        <div class="container">
            <div class="d-flex align-items-center gap-3 py-2">
                <a class="brand" asp-controller="Home" asp-action="Index"><span class="brand-mark"><i class="bi bi-boxes"></i></span>NexaCommerce</a>
                <form class="search-wrap d-none d-md-block ms-3" asp-controller="Shop" asp-action="Index" method="get">
                    <i class="bi bi-search"></i>
                    <input class="form-control" name="q" value="@Context.Request.Query["q"]" placeholder="Search products, brands or SKU" aria-label="Search" />
                </form>
                <nav class="ms-auto d-flex align-items-center gap-1">
                    <a class="nav-icon" asp-controller="Shop" asp-action="Deals" title="Deals"><i class="bi bi-lightning-charge"></i><span class="d-none d-lg-inline fs-6 fw-semibold">Deals</span></a>
                    <a class="nav-icon" asp-controller="Compare" asp-action="Index" title="Compare"><i class="bi bi-layout-split"></i></a>
                    <a class="nav-icon" asp-controller="Wishlist" asp-action="Index" title="Wishlist"><i class="bi bi-heart"></i></a>
                    <a class="nav-icon" asp-controller="Cart" asp-action="Index" title="Cart"><i class="bi bi-bag"></i>@if (cartCount > 0)
                        {
                            <span class="count">@cartCount</span>
                        }</a>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <div class="dropdown">
                            <a class="nav-icon dropdown-toggle" href="#" data-bs-toggle="dropdown" aria-expanded="false"><i class="bi bi-person-circle"></i><span class="d-none d-lg-inline fs-6 fw-semibold">@User.GetFullName().Split(' ')[0]</span></a>
                            <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                <li><a class="dropdown-item" asp-controller="MyOrders" asp-action="Index"><i class="bi bi-receipt me-2"></i>My orders</a></li>
                                <li><a class="dropdown-item" asp-controller="Account" asp-action="Profile"><i class="bi bi-person me-2"></i>Profile</a></li>
                                <li><a class="dropdown-item" asp-controller="Account" asp-action="Addresses"><i class="bi bi-geo-alt me-2"></i>Addresses</a></li>
                                @if (User.IsBackOffice())
                                {
                                    <li><a class="dropdown-item" asp-area="Admin" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-speedometer2 me-2"></i>Back office</a></li>
                                }
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <form asp-area="" asp-controller="Account" asp-action="Logout" method="post">
                                        <button class="dropdown-item" type="submit"><i class="bi bi-box-arrow-right me-2"></i>Sign out</button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <a class="btn btn-ink btn-sm ms-2" asp-controller="Account" asp-action="Login">Sign in</a>
                    }
                </nav>
            </div>
            <form class="search-wrap d-md-none pb-2" asp-controller="Shop" asp-action="Index" method="get">
                <i class="bi bi-search"></i>
                <input class="form-control" name="q" placeholder="Search products" aria-label="Search" />
            </form>
        </div>
        <div class="cat-strip">
            <div class="container overflow-auto text-nowrap">
                <a asp-controller="Shop" asp-action="Index" class="@(Context.Request.Path.StartsWithSegments("/Shop") && string.IsNullOrEmpty(currentCat) ? "active" : "")">All products</a>
                @foreach (var c in navCats)
                {
                    <a asp-controller="Shop" asp-action="Index" asp-route-category="@c.CategoryId" class="@(currentCat == c.CategoryId.ToString() ? "active" : "")">@c.Name</a>
                }
            </div>
        </div>
    </header>

    <main>
        <div class="container mt-3">
            <partial name="_Alerts" />
        </div>
        @RenderBody()
    </main>

    <footer class="store-footer">
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-4">
                    <div class="brand mb-2"><span class="brand-mark"><i class="bi bi-boxes"></i></span>NexaCommerce</div>
                    <p class="mb-0" style="max-width:34ch">Everyday goods from Bangladeshi suppliers, restocked using demand forecasts so what you see is what we have.</p>
                </div>
                <div class="col-6 col-lg-2">
                    <h6>Shop</h6>
                    <a asp-controller="Shop" asp-action="Index">All products</a>
                    <a asp-controller="Shop" asp-action="Deals">Deals</a>
                    <a asp-controller="Compare" asp-action="Index">Compare</a>
                </div>
                <div class="col-6 col-lg-2">
                    <h6>Account</h6>
                    <a asp-controller="MyOrders" asp-action="Index">Orders</a>
                    <a asp-controller="Wishlist" asp-action="Index">Wishlist</a>
                    <a asp-controller="Account" asp-action="Profile">Profile</a>
                </div>
                <div class="col-6 col-lg-2">
                    <h6>Help</h6>
                    <a asp-controller="Home" asp-action="Faq">FAQ</a>
                    <a asp-controller="Home" asp-action="Contact">Contact</a>
                    <a asp-controller="Home" asp-action="About">About</a>
                </div>
                <div class="col-6 col-lg-2">
                    <h6>Legal</h6>
                    <a asp-controller="Home" asp-action="Privacy">Privacy</a>
                    <a asp-controller="Home" asp-action="Terms">Terms</a>
                </div>
            </div>
            <div class="divider" style="background:rgba(255,255,255,.1)"></div>
            <div class="d-flex justify-content-between flex-wrap gap-2 small">
                <span>&copy; @DateTime.Now.Year NexaCommerce. Built with ASP.NET Core MVC, Dapper and SQL Server.</span>
                <span>Payments in this build use a simulated gateway.</span>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
