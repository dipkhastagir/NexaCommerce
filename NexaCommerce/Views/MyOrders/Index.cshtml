@model PagedResult<Order>
@{
    ViewData["Title"] = "My orders";
    var status = Context.Request.Query["status"].ToString();
}
<div class="container py-3">
    <div class="row g-4">
        <div class="col-lg-3"><partial name="_AccountNav" /></div>
        <div class="col-lg-9">
            <h1 class="h3 mb-3">My orders</h1>
            <div class="tab-links">
                <a href="@QueryHelper.With(Context.Request, "status", "")" class="@(string.IsNullOrEmpty(status) ? "active" : "")">All</a>
                @foreach (var s in new[] { "Pending", "Confirmed", "Processing", "Shipped", "Delivered", "Cancelled" })
                {
                    <a href="@QueryHelper.With(Context.Request, "status", s)" class="@(status == s ? "active" : "")">@s</a>
                }
            </div>
            @if (!Model.Items.Any())
            {
                <div class="panel empty"><i class="bi bi-receipt"></i>No orders here yet.<br /><a class="btn btn-primary mt-3" asp-controller="Shop" asp-action="Index">Browse products</a></div>
            }
            @foreach (var o in Model.Items)
            {
                <div class="panel mb-3">
                    <div class="d-flex justify-content-between flex-wrap gap-2">
                        <div>
                            <b>Order @o.OrderNumber</b> <span class="pill @Badge.OrderStatus(o.Status) ms-1">@o.Status</span>
                            <div class="small text-muted">Placed @Fmt.Stamp(o.CreatedAt) &middot; @o.ItemCount items &middot; @o.PaymentMethod</div>
                        </div>
                        <div class="text-end">
                            <div class="price">@Fmt.Money(o.TotalAmount)</div>
                            <div class="d-flex gap-2 mt-1">
                                <a class="btn btn-ghost btn-sm" asp-action="Track" asp-route-id="@o.OrderId">Track</a>
                                <a class="btn btn-ink btn-sm" asp-action="Details" asp-route-id="@o.OrderId">Details</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
            <partial name="_Pagination" model="@((Model.Page, Model.TotalPages, Model.TotalCount))" />
        </div>
    </div>
</div>
