@model ShopVm
@{ ViewData["Title"] = "Deals"; }
<div class="container py-3">
    <div class="crumbs"><a asp-controller="Home" asp-action="Index">Home</a> / Deals</div>
    <h1 class="h2">Deals</h1>
    <p class="text-muted">Every product currently priced below its regular price, biggest saving first.</p>
    @if (!Model.Products.Items.Any())
    {
        <div class="panel empty"><i class="bi bi-tag"></i>No markdowns right now. Check back soon.</div>
    }
    <div class="row g-3">
        @foreach (var p in Model.Products.Items)
        {
            <div class="col-6 col-md-4 col-lg-3"><partial name="_ProductCard" model="p" /></div>
        }
    </div>
</div>
