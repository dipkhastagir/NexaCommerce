@model ProductDetailsVm
@{
    var p = Model.Product;
    ViewData["Title"] = p.Name;
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
}
<div class="container py-3">
    <div class="crumbs mb-2"><a asp-controller="Home" asp-action="Index">Home</a> / <a asp-action="Index" asp-route-category="@p.CategoryId">@p.CategoryName</a> / @p.Name</div>
    <div class="row g-4">
        <div class="col-lg-6">
            <div class="pd-art" style="background:@Visual.Tint(p.CategoryId);color:@Visual.Ink(p.CategoryId)"><i class="bi @p.CategoryIcon"></i></div>
        </div>
        <div class="col-lg-6">
            <span class="small-caps">@p.BrandName &middot; SKU @p.Sku</span>
            <h1 class="pd-title mt-1">@p.Name</h1>
            @if (p.ReviewCount > 0)
            {
                <div class="stars mb-2">@for (var i = 1; i <= 5; i++) { <i class="bi @(i <= Math.Round(p.AvgRating) ? "bi-star-fill" : "bi-star")"></i> }<span class="text-muted ms-2">@p.AvgRating.ToString("0.0") from @p.ReviewCount reviews</span></div>
            }
            <div class="d-flex align-items-baseline gap-2 my-3">
                <span class="pd-price">@Fmt.Money(p.EffectivePrice)</span>
                @if (p.OnSale)
                {
                    <span class="price-old fs-5">@Fmt.Money(p.Price)</span>
                    <span class="pill st-cancelled">Save @p.DiscountPercent%</span>
                }
            </div>
            <p class="text-muted">@p.Description</p>
            <div class="stock-line @Badge.Stock(p.StockStatus) mb-3 fs-6">
                <i class="bi bi-circle-fill me-1" style="font-size:.6rem"></i>@(p.StockQuantity == 0 ? "Out of stock" : p.StockQuantity <= p.ReorderLevel ? $"Only {p.StockQuantity} left - order soon" : $"{p.StockQuantity} in stock, ships in 1-2 days")
            </div>
            @if (p.StockQuantity > 0 && p.IsActive)
            {
                <form asp-controller="Cart" asp-action="Add" method="post" class="d-flex gap-2 align-items-center flex-wrap">
                    <input type="hidden" name="productId" value="@p.ProductId" />
                    <div class="input-group" style="width:140px" data-stepper>
                        <button class="btn btn-ghost" type="button" data-step="-1" aria-label="Decrease">-</button>
                        <input class="form-control qty-input" type="number" name="quantity" value="1" min="1" max="@p.StockQuantity" aria-label="Quantity" />
                        <button class="btn btn-ghost" type="button" data-step="1" aria-label="Increase">+</button>
                    </div>
                    <button class="btn btn-primary px-4" type="submit"><i class="bi bi-bag-plus me-1"></i>Add to cart</button>
                </form>
            }
            <div class="d-flex gap-2 mt-2">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <form asp-controller="Wishlist" asp-action="Toggle" method="post">
                        <input type="hidden" name="productId" value="@p.ProductId" /><input type="hidden" name="returnUrl" value="@returnUrl" />
                        <button class="btn btn-ghost btn-sm" type="submit"><i class="bi @(Model.InWishlist ? "bi-heart-fill text-danger" : "bi-heart") me-1"></i>@(Model.InWishlist ? "Saved" : "Save")</button>
                    </form>
                }
                <form asp-controller="Compare" asp-action="Add" method="post">
                    <input type="hidden" name="productId" value="@p.ProductId" /><input type="hidden" name="returnUrl" value="@returnUrl" />
                    <button class="btn btn-ghost btn-sm" type="submit"><i class="bi bi-layout-split me-1"></i>Compare</button>
                </form>
                @if (User.IsBackOffice())
                {
                    <a class="btn btn-ghost btn-sm" asp-area="Admin" asp-controller="Products" asp-action="Details" asp-route-id="@p.ProductId"><i class="bi bi-pencil me-1"></i>Manage</a>
                }
            </div>
            <table class="spec-table w-100 mt-4">
                <tr><td>Category</td><td>@p.CategoryName</td></tr>
                <tr><td>Brand</td><td>@(p.BrandName ?? "-")</td></tr>
                <tr><td>SKU</td><td>@p.Sku</td></tr>
                <tr><td>Sold so far</td><td>@p.UnitsSold units</td></tr>
                <tr><td>Delivery</td><td>@Fmt.Money(60), free over @Fmt.Money(2000)</td></tr>
            </table>
        </div>
    </div>

    @if (Model.BoughtTogether.Any())
    {
        <div class="together mt-4">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h2 class="h5 mb-0">Frequently bought together</h2>
                <span class="small text-muted">From real orders</span>
            </div>
            <div class="row g-3">
                @foreach (var r in Model.BoughtTogether)
                {
                    <div class="col-md-6 col-lg-3">
                        <div class="d-flex gap-2 align-items-center">
                            <span class="thumb" style="background:@Visual.Tint(r.ConsequentId);color:@Visual.Ink(r.ConsequentId)"><i class="bi @r.ConsequentIcon"></i></span>
                            <div class="lh-sm">
                                <a class="fw-semibold" asp-action="Details" asp-route-id="@r.ConsequentId">@r.ConsequentName</a>
                                <div class="small text-muted">@Fmt.Money(r.ConsequentPrice) &middot; @Fmt.Pct(r.Confidence, 0) of buyers add it</div>
                                <form asp-controller="Cart" asp-action="Add" method="post" class="mt-1">
                                    <input type="hidden" name="productId" value="@r.ConsequentId" /><input type="hidden" name="returnUrl" value="@returnUrl" />
                                    <button class="btn btn-outline-primary btn-sm py-0" type="submit">Add</button>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    <div class="row g-4 mt-2">
        <div class="col-lg-4">
            <div class="panel">
                <h2 class="panel-title">Ratings</h2>
                @if (Model.Reviews.Any())
                {
                    <div class="display-font fs-1 fw-bold">@p.AvgRating.ToString("0.0")<span class="fs-6 text-muted"> / 5</span></div>
                    @for (var s = 5; s >= 1; s--)
                    {
                        var n = Model.RatingHistogram[s - 1];
                        <div class="hist-row mt-1"><span style="width:14px">@s</span><i class="bi bi-star-fill text-warning"></i><div class="bar"><span style="width:@(Model.Reviews.Count == 0 ? 0 : 100 * n / Model.Reviews.Count)%"></span></div><span class="text-muted" style="width:24px">@n</span></div>
                    }
                }
                else
                {
                    <p class="text-muted mb-0">No reviews yet.</p>
                }
                @if (Model.CanReview)
                {
                    <a class="btn btn-primary btn-sm mt-3" asp-controller="MyOrders" asp-action="Review" asp-route-productId="@p.ProductId">Write a review</a>
                }
            </div>
        </div>
        <div class="col-lg-8">
            <div class="panel">
                <h2 class="panel-title">Customer reviews</h2>
                @if (!Model.Reviews.Any())
                {
                    <p class="text-muted mb-0">Bought this? Reviews from verified buyers appear here.</p>
                }
                @foreach (var r in Model.Reviews.Take(10))
                {
                    <div class="pb-3 mb-3 border-bottom">
                        <div class="d-flex justify-content-between">
                            <b>@r.Title</b>
                            <span class="stars">@for (var i = 1; i <= 5; i++) { <i class="bi @(i <= r.Rating ? "bi-star-fill" : "bi-star")"></i> }</span>
                        </div>
                        <p class="mb-1 mt-1">@r.Comment</p>
                        <small class="text-muted">@r.UserName &middot; @Fmt.Date(r.CreatedAt) &middot; <i class="bi bi-patch-check text-success"></i> Verified purchase</small>
                    </div>
                }
            </div>
        </div>
    </div>

    @if (Model.Related.Any())
    {
        <div class="section-head mt-5"><h2>More in @p.CategoryName</h2></div>
        <div class="row g-3">
            @foreach (var r in Model.Related)
            {
                <div class="col-6 col-lg-3"><partial name="_ProductCard" model="r" /></div>
            }
        </div>
    }
</div>
