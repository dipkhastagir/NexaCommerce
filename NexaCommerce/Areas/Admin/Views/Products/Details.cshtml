@model Product
@{
    ViewData["Title"] = Model.Name;
    var moves = (List<StockMovement>)ViewBag.Movements;
    var f = (ForecastResult)ViewBag.Forecast;
    var canEdit = User.IsInRole("Admin") || User.IsInRole("Manager");
}
<div class="page-head">
    <div>
        <div class="crumbs"><a asp-action="Index">Products</a> / @Model.Sku</div>
        <h1>@Model.Name</h1>
        <div class="sub">@Model.CategoryName &middot; @(Model.BrandName ?? "No brand") &middot; added @Fmt.Date(Model.CreatedAt)</div>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <a class="btn btn-ghost btn-sm" asp-area="" asp-controller="Shop" asp-action="Details" asp-route-id="@Model.ProductId" target="_blank"><i class="bi bi-box-arrow-up-right me-1"></i>View in store</a>
        <a class="btn btn-ghost btn-sm" asp-controller="Inventory" asp-action="Adjust" asp-route-id="@Model.ProductId"><i class="bi bi-plus-slash-minus me-1"></i>Adjust stock</a>
        @if (canEdit)
        {
            <form asp-action="ToggleActive" method="post"><input type="hidden" name="id" value="@Model.ProductId" /><button class="btn btn-ghost btn-sm" type="submit">@(Model.IsActive ? "Hide from store" : "Publish")</button></form>
            <a class="btn btn-primary btn-sm" asp-action="Edit" asp-route-id="@Model.ProductId"><i class="bi bi-pencil me-1"></i>Edit</a>
            <a class="btn btn-ghost btn-sm text-danger" asp-action="Delete" asp-route-id="@Model.ProductId"><i class="bi bi-trash"></i></a>
        }
    </div>
</div>
<div class="row g-3 mb-3">
    <div class="col-sm-6 col-xl-3"><div class="stat violet"><div class="lbl">Selling price</div><div class="val">@Fmt.Money(Model.EffectivePrice)</div><div class="meta">@(Model.OnSale ? $"Regular {Fmt.Money(Model.Price)}, {Model.DiscountPercent}% off" : "No markdown")</div></div></div>
    <div class="col-sm-6 col-xl-3"><div class="stat mint"><div class="lbl">Gross margin</div><div class="val">@Model.MarginPercent%</div><div class="meta">Cost @Fmt.Money(Model.CostPrice)</div></div></div>
    <div class="col-sm-6 col-xl-3"><div class="stat @(Model.StockQuantity <= Model.ReorderLevel ? "coral" : "")"><div class="lbl">On hand</div><div class="val">@Model.StockQuantity</div><div class="meta">Reorder level @Model.ReorderLevel &middot; <span class="@Badge.Stock(Model.StockStatus)">@Model.StockStatus</span></div></div></div>
    <div class="col-sm-6 col-xl-3"><div class="stat sky"><div class="lbl">Units sold</div><div class="val">@Model.UnitsSold</div><div class="meta">@(Model.ReviewCount > 0 ? $"{Model.AvgRating:0.0} stars from {Model.ReviewCount} reviews" : "No reviews yet")</div></div></div>
</div>
<div class="row g-3">
    <div class="col-xl-8">
        <div class="panel mb-3">
            <div class="panel-title">Demand forecast
                @if (f != null)
                {
                    <a class="small fw-normal" asp-controller="Intelligence" asp-action="ForecastDetail" asp-route-id="@Model.ProductId">Model details</a>
                }
            </div>
            @if (f == null)
            {
                <p class="text-muted mb-0">Forecasts are produced for active products with sales history.</p>
            }
            else
            {
                <div class="d-flex gap-4 flex-wrap small mb-2">
                    <span>Next 30 days: <b>@Fmt.Num(f.ForecastTotal, 0) units</b></span>
                    <span>Trend: <b>@f.TrendLabel</b></span>
                    <span>Stock-out: <b>@(f.DaysUntilStockout.HasValue ? $"in ~{f.DaysUntilStockout} days" : "not within horizon")</b></span>
                </div>
                <div class="chart-box short"><canvas id="fc"></canvas></div>
            }
        </div>
        <div class="panel">
            <div class="panel-title">Recent stock movements <a class="small fw-normal" asp-controller="Inventory" asp-action="Movements" asp-route-productId="@Model.ProductId">Full ledger</a></div>
            <table class="table-nx">
                <thead><tr><th>When</th><th>Type</th><th class="text-end">Qty</th><th class="text-end">Balance</th><th>Reference</th></tr></thead>
                <tbody>
                    @foreach (var m in moves)
                    {
                        <tr><td class="small">@Fmt.Stamp(m.CreatedAt)</td><td><span class="pill st-default">@m.MovementType</span></td><td class="text-end tabular fw-bold @(m.Quantity < 0 ? "text-danger" : "text-success")">@m.Quantity.ToString("+#;-#;0")</td><td class="text-end tabular">@m.BalanceAfter</td><td class="small">@m.Reference</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <div class="col-xl-4">
        <div class="panel mb-3">
            <div class="panel-title">Details</div>
            <dl class="kv">
                <dt>SKU</dt><dd>@Model.Sku</dd>
                <dt>Supplier</dt><dd>@if (Model.SupplierId.HasValue) { <a asp-controller="Suppliers" asp-action="Details" asp-route-id="@Model.SupplierId">@Model.SupplierName</a> } else { <span>-</span> }</dd>
                <dt>Visibility</dt><dd>@(Model.IsActive ? "Visible in store" : "Hidden")</dd>
                <dt>Featured</dt><dd>@(Model.IsFeatured ? "Yes" : "No")</dd>
                <dt>Stock value</dt><dd>@Fmt.Money(Model.StockQuantity * Model.CostPrice)</dd>
                <dt>Last updated</dt><dd>@Fmt.Stamp(Model.UpdatedAt ?? Model.CreatedAt)</dd>
            </dl>
        </div>
        <div class="panel">
            <div class="panel-title">Description</div>
            <p class="mb-0 text-muted">@(string.IsNullOrWhiteSpace(Model.Description) ? "No description yet." : Model.Description)</p>
        </div>
    </div>
</div>
@{
    string fcLabels = "[]", fcActual = "[]", fcForecast = "[]";
    if (f != null)
    {
        var tail = f.History.Skip(Math.Max(0, f.History.Count - 45)).ToList();
        fcLabels = System.Text.Json.JsonSerializer.Serialize(tail.Select(h => h.Date.ToString("dd MMM")).Concat(f.Forecast.Select(x => x.Date.ToString("dd MMM"))));
        fcActual = System.Text.Json.JsonSerializer.Serialize(tail.Select(h => (double?)h.Units).Concat(f.Forecast.Select(_ => (double?)null)));
        fcForecast = System.Text.Json.JsonSerializer.Serialize(tail.Select(_ => (double?)null).Concat(f.Forecast.Select(x => (double?)Math.Round(x.Units, 2))));
    }
}
@section Scripts {
<script>
    if (document.getElementById('fc')) {
        new Chart(document.getElementById('fc'), {
            type: 'line',
            data: {
                labels: @Html.Raw(fcLabels),
                datasets: [
                    { label: 'Actual units', data: @Html.Raw(fcActual), borderColor: '#17153B', backgroundColor: '#17153B', pointRadius: 0, tension: .2 },
                    { label: 'Forecast', data: @Html.Raw(fcForecast), borderColor: '#5B3DF5', borderDash: [6, 4], pointRadius: 0 }
                ]
            },
            options: { scales: { x: { grid: { display: false }, ticks: { maxTicksLimit: 8 } }, y: { beginAtZero: true } } }
        });
    }
</script>
}
