@inject NexaCommerce.Services.NotificationService Notifications
@inject NexaCommerce.Services.ReportService Reports
@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    var unread = await Notifications.UnreadCountAsync(User.GetUserId());
    var stats = await Reports.StatsAsync();
    var isMgmt = User.IsInRole("Admin") || User.IsInRole("Manager");
    var isAdmin = User.IsInRole("Admin");
    string Active(string c, string a = null) => controller == c && (a == null || action == a) ? "side-link active" : "side-link";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] | NexaCommerce Back Office</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,650;12..96,750;12..96,800&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="admin-body">
    <div class="admin-shell">
        <aside class="sidebar" aria-label="Back office navigation">
            <a class="brand" asp-area="Admin" asp-controller="Dashboard" asp-action="Index"><span class="brand-mark"><i class="bi bi-boxes"></i></span>Nexa<span style="font-weight:500;opacity:.7">Admin</span></a>
            <a class="@Active("Dashboard")" asp-area="Admin" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-speedometer2"></i>Dashboard</a>
            <a class="@Active("Notifications")" asp-area="Admin" asp-controller="Notifications" asp-action="Index"><i class="bi bi-bell"></i>Notifications@if (unread > 0) { <span class="badge-n">@unread</span> }</a>

            <div class="side-group">Sales</div>
            <a class="@Active("Orders")" asp-area="Admin" asp-controller="Orders" asp-action="Index"><i class="bi bi-receipt"></i>Orders@if (stats.PendingOrders > 0) { <span class="badge-n" style="background:var(--amber)">@stats.PendingOrders</span> }</a>
            <a class="@Active("Customers")" asp-area="Admin" asp-controller="Customers" asp-action="Index"><i class="bi bi-people"></i>Customers</a>
            <a class="@Active("Returns")" asp-area="Admin" asp-controller="Returns" asp-action="Index"><i class="bi bi-arrow-counterclockwise"></i>Returns@if (stats.OpenReturns > 0) { <span class="badge-n">@stats.OpenReturns</span> }</a>
            <a class="@Active("Reviews")" asp-area="Admin" asp-controller="Reviews" asp-action="Index"><i class="bi bi-chat-square-quote"></i>Reviews@if (stats.PendingReviews > 0) { <span class="badge-n" style="background:var(--amber)">@stats.PendingReviews</span> }</a>
            <a class="@Active("Messages")" asp-area="Admin" asp-controller="Messages" asp-action="Index"><i class="bi bi-envelope"></i>Messages</a>
            @if (isMgmt)
            {
                <a class="@Active("Coupons")" asp-area="Admin" asp-controller="Coupons" asp-action="Index"><i class="bi bi-ticket-perforated"></i>Coupons</a>
            }

            <div class="side-group">Catalog &amp; stock</div>
            <a class="@Active("Products")" asp-area="Admin" asp-controller="Products" asp-action="Index"><i class="bi bi-box-seam"></i>Products</a>
            @if (isMgmt)
            {
                <a class="@Active("Categories")" asp-area="Admin" asp-controller="Categories" asp-action="Index"><i class="bi bi-diagram-2"></i>Categories</a>
                <a class="@Active("Brands")" asp-area="Admin" asp-controller="Brands" asp-action="Index"><i class="bi bi-award"></i>Brands</a>
            }
            <a class="@Active("Inventory")" asp-area="Admin" asp-controller="Inventory" asp-action="Index"><i class="bi bi-clipboard-data"></i>Inventory@if (stats.LowStockCount + stats.OutOfStockCount > 0) { <span class="badge-n">@(stats.LowStockCount + stats.OutOfStockCount)</span> }</a>
            @if (isMgmt)
            {
                <a class="@Active("PurchaseOrders")" asp-area="Admin" asp-controller="PurchaseOrders" asp-action="Index"><i class="bi bi-cart-check"></i>Purchase orders</a>
                <a class="@Active("Suppliers")" asp-area="Admin" asp-controller="Suppliers" asp-action="Index"><i class="bi bi-truck"></i>Suppliers</a>
                <a class="@Active("Warehouses")" asp-area="Admin" asp-controller="Warehouses" asp-action="Index"><i class="bi bi-buildings"></i>Warehouses</a>

                <div class="side-group">Intelligence</div>
                <a class="@Active("Intelligence", "Index")" asp-area="Admin" asp-controller="Intelligence" asp-action="Index"><i class="bi bi-cpu"></i>Overview</a>
                <a class="@Active("Intelligence", "Forecast")" asp-area="Admin" asp-controller="Intelligence" asp-action="Forecast"><i class="bi bi-graph-up-arrow"></i>Demand forecast</a>
                <a class="@Active("Intelligence", "Reorder")" asp-area="Admin" asp-controller="Intelligence" asp-action="Reorder"><i class="bi bi-arrow-repeat"></i>Reorder planner</a>
                <a class="@Active("Intelligence", "Segments")" asp-area="Admin" asp-controller="Intelligence" asp-action="Segments"><i class="bi bi-pie-chart"></i>Customer segments</a>
                <a class="@Active("Intelligence", "Basket")" asp-area="Admin" asp-controller="Intelligence" asp-action="Basket"><i class="bi bi-diagram-3"></i>Basket rules</a>
                <a class="@Active("Intelligence", "Abc")" asp-area="Admin" asp-controller="Intelligence" asp-action="Abc"><i class="bi bi-bar-chart-steps"></i>ABC analysis</a>
                <a class="@Active("Intelligence", "Risk")" asp-area="Admin" asp-controller="Intelligence" asp-action="Risk"><i class="bi bi-shield-exclamation"></i>Order risk@if (stats.HighRiskOrders > 0) { <span class="badge-n">@stats.HighRiskOrders</span> }</a>
                <a class="@Active("Intelligence", "Datasets")" asp-area="Admin" asp-controller="Intelligence" asp-action="Datasets"><i class="bi bi-database-down"></i>Research datasets</a>

                <div class="side-group">Reports</div>
                <a class="@Active("Reports")" asp-area="Admin" asp-controller="Reports" asp-action="Index"><i class="bi bi-file-earmark-bar-graph"></i>Reports</a>
            }
            <div class="side-group">System</div>
            @if (isAdmin)
            {
                <a class="@Active("Users")" asp-area="Admin" asp-controller="Users" asp-action="Index"><i class="bi bi-person-gear"></i>Users &amp; roles</a>
                <a class="@Active("AuditLogs")" asp-area="Admin" asp-controller="AuditLogs" asp-action="Index"><i class="bi bi-journal-text"></i>Audit log</a>
                <a class="@Active("Settings")" asp-area="Admin" asp-controller="Settings" asp-action="Index"><i class="bi bi-sliders"></i>Settings</a>
            }
            <a class="@Active("ApiDocs")" asp-area="Admin" asp-controller="ApiDocs" asp-action="Index"><i class="bi bi-braces"></i>REST API</a>
            <a class="side-link" asp-area="" asp-controller="Home" asp-action="Index"><i class="bi bi-shop"></i>View store</a>
        </aside>
        <div class="admin-main">
            <header class="admin-top">
                <button class="btn btn-ghost btn-sm d-lg-none" id="sidebarToggle" type="button" aria-label="Menu"><i class="bi bi-list"></i></button>
                <form class="search-wrap" asp-area="Admin" asp-controller="Orders" asp-action="Index" method="get" style="max-width:380px">
                    <i class="bi bi-search"></i>
                    <input class="form-control form-control-sm" name="q" placeholder="Find an order, customer or phone" aria-label="Search orders" />
                </form>
                <div class="ms-auto d-flex align-items-center gap-3">
                    <a class="nav-icon" asp-area="Admin" asp-controller="Notifications" asp-action="Index" aria-label="Notifications"><i class="bi bi-bell"></i>@if (unread > 0) { <span class="count">@unread</span> }</a>
                    <div class="dropdown">
                        <a class="d-flex align-items-center gap-2 text-body dropdown-toggle" href="#" data-bs-toggle="dropdown">
                            <span class="mini-thumb fw-bold" style="background:var(--violet-soft);color:var(--violet-deep);width:34px;height:34px">@Visual.Initials(User.GetFullName())</span>
                            <span class="lh-sm d-none d-md-block"><b class="small">@User.GetFullName()</b><br /><small class="text-muted">@User.GetRole()</small></span>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                            <li><a class="dropdown-item" asp-area="" asp-controller="Account" asp-action="Profile">Profile</a></li>
                            <li><a class="dropdown-item" asp-area="" asp-controller="Account" asp-action="ChangePassword">Change password</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><form asp-area="" asp-controller="Account" asp-action="Logout" method="post"><button class="dropdown-item" type="submit">Sign out</button></form></li>
                        </ul>
                    </div>
                </div>
            </header>
            <main class="admin-content">
                <partial name="_Alerts" />
                @RenderBody()
            </main>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>window.nxChartDefaults && window.nxChartDefaults();</script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
