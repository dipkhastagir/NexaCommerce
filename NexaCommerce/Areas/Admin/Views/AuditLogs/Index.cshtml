@model PagedResult<AuditLog>
@{ ViewData["Title"] = "Audit log"; var entities = (List<string>)ViewBag.Entities; }
<div class="page-head"><div><h1>Audit log</h1><div class="sub">Every sign-in, change and export, with who did it and from where.</div></div></div>
<form method="get" class="filter-bar row g-2">
    <div class="col-md-6"><input class="form-control" name="q" value="@ViewBag.Q" placeholder="Search user, action or details" /></div>
    <div class="col-md-4"><select class="form-select" name="entity"><option value="">All entities</option>@foreach (var e in entities) { <option value="@e" selected="@(ViewBag.Entity == e)">@e</option> }</select></div>
    <div class="col-md-2"><button class="btn btn-ink w-100" type="submit">Filter</button></div>
</form>
<div class="table-wrap"><div class="table-scroll">
    <table class="table-nx">
        <thead><tr><th>When</th><th>User</th><th>Action</th><th>Entity</th><th>Details</th><th>IP</th></tr></thead>
        <tbody>
            @foreach (var a in Model.Items)
            {
                <tr><td class="small text-nowrap">@Fmt.Stamp(a.CreatedAt)</td><td class="small">@(a.UserEmail ?? "anonymous")</td><td><span class="pill st-default">@a.Action</span></td><td class="small">@a.Entity @(a.EntityId != null ? "#" + a.EntityId : "")</td><td class="small text-muted">@a.Details</td><td class="small text-muted">@a.IpAddress</td></tr>
            }
        </tbody>
    </table>
</div></div>
<partial name="_Pagination" model="@((Model.Page, Model.TotalPages, Model.TotalCount))" />
