@model Warehouse
@{ ViewData["Title"] = Model.WarehouseId > 0 ? "Edit " + Model.Name : "New warehouse"; }
<div class="page-head"><div><div class="crumbs"><a asp-action="Index">Warehouses</a></div><h1>@ViewData["Title"]</h1></div></div>
<form asp-action="Form" method="post" class="panel" style="max-width:640px">
    <input type="hidden" asp-for="WarehouseId" />
    <div class="mb-3"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" /><span asp-validation-for="Name"></span></div>
    <div class="mb-3"><label asp-for="Location" class="form-label"></label><input asp-for="Location" class="form-control" /></div>
    <div class="mb-3"><label asp-for="Capacity" class="form-label">Capacity (units)</label><input asp-for="Capacity" class="form-control" /><span asp-validation-for="Capacity"></span></div>
    <div class="form-check form-switch mb-3"><input asp-for="IsActive" class="form-check-input" /><label asp-for="IsActive" class="form-check-label"></label></div>
    <button class="btn btn-primary" type="submit">Save warehouse</button> <a class="btn btn-ghost" asp-action="Index">Cancel</a>
</form>
