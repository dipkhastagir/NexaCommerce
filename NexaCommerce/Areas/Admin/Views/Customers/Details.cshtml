@model CustomerDetailsVm
@{
    var c = Model.Customer;
    ViewData["Title"] = c.FullName;
    var avg = c.OrderCount == 0 ? 0 : c.TotalSpent / c.OrderCount;
}
<div class="page-head">
    <div><div class="crumbs"><a asp-action="Index">Customers</a> / @c.FullName</div><h1>@c.FullName</h1><div class="sub">@c.Email &middot; @c.Phone &middot; joined @Fmt.Date(c.CreatedAt)</div></div>
    @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
    {
        <form asp-action="ToggleActive" method="post" data-confirm="@(c.IsActive ? "Block this customer from signing in?" : "Re-activate this customer?")"><input type="hidden" name="id" value="@c.UserId" /><input type="hidden" name="active" value="@((!c.IsActive).ToString())" /><button class="btn btn-ghost btn-sm @(c.IsActive ? "text-danger" : "")" type="submit">@(c.IsActive ? "Block customer" : "Re-activate")</button></form>
    }
</div>
<div class="row g-3 mb-3">
    <div class="col-md-3"><div class="stat violet"><div class="lbl">Lifetime value</div><div class="val">@Fmt.Money(c.TotalSpent)</div></div></div>
    <div class="col-md-3"><div class="stat mint"><div class="lbl">Orders</div><div class="val">@c.OrderCount</div><div class="meta">Average @Fmt.Money(avg)</div></div></div>
    <div class="col-md-3"><div class="stat"><div class="lbl">Last order</div><div class="val fs-5">@(c.LastOrderDate.HasValue ? Fmt.Ago(c.LastOrderDate.Value) : "Never")</div></div></div>
    <div class="col-md-3"><div class="stat sky"><div class="lbl">RFM segment</div><div class="val fs-5">@(Model.Rfm?.Segment ?? "-")</div>@if (Model.Rfm != null && Model.Rfm.Frequency > 0) { <div class="meta">Score R@(Model.Rfm.R) F@(Model.Rfm.F) M@(Model.Rfm.M)</div> }</div></div>
</div>
<div class="row g-3">
    <div class="col-xl-8">
        <div class="table-wrap">
            <div class="p-3 pb-2 fw-bold">Order history</div>
            <table class="table-nx">
                <thead><tr><th>Order</th><th>Date</th><th>Status</th><th>Risk</th><th class="text-end">Total</th></tr></thead>
                <tbody>
                    @foreach (var o in Model.Orders)
                    {
                        <tr><td><a asp-controller="Orders" asp-action="Details" asp-route-id="@o.OrderId" class="fw-bold">@o.OrderNumber</a></td><td class="small">@Fmt.Stamp(o.CreatedAt)</td><td><span class="pill @Badge.OrderStatus(o.Status)">@o.Status</span></td><td><span class="pill @Badge.Risk(o.RiskLevel)">@o.RiskScore</span></td><td class="text-end tabular">@Fmt.Money(o.TotalAmount)</td></tr>
                    }
                </tbody>
            </table>
            @if (!Model.Orders.Any()) { <div class="empty py-3">No orders yet.</div> }
        </div>
    </div>
    <div class="col-xl-4">
        <div class="panel">
            <div class="panel-title">Addresses</div>
            @foreach (var a in Model.Addresses) { <div class="mb-2 small"><b>@a.Label</b>@if (a.IsDefault) { <span class="pill st-default ms-1">Default</span> }<br />@a.Line1, @a.City</div> }
            @if (!Model.Addresses.Any()) { <p class="text-muted small mb-0">None saved.</p> }
        </div>
    </div>
</div>
