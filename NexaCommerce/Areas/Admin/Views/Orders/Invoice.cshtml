@model Order
@inject NexaCommerce.Services.SettingsService Settings
@{
    Layout = null;
    var store = await Settings.GetAsync("StoreName", "NexaCommerce");
    var address = await Settings.GetAsync("StoreAddress", "");
    var email = await Settings.GetAsync("StoreEmail", "");
    var phone = await Settings.GetAsync("StorePhone", "");
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Invoice @Model.OrderNumber</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <div class="invoice">
        <div class="d-flex justify-content-between align-items-start mb-4">
            <div>
                <div class="brand"><span class="brand-mark">N</span>@store</div>
                <div class="small text-muted mt-2">@address<br />@email &middot; @phone</div>
            </div>
            <div class="text-end">
                <h1 class="h3 mb-0">Invoice</h1>
                <div class="small">@Model.OrderNumber<br />@Fmt.Date(Model.CreatedAt)</div>
                <span class="pill @Badge.Payment(Model.PaymentStatus) mt-1">@Model.PaymentStatus</span>
            </div>
        </div>
        <div class="row mb-4">
            <div class="col-6"><div class="small-caps">Billed to</div>@Model.CustomerName<br /><span class="small">@Model.CustomerEmail</span></div>
            <div class="col-6"><div class="small-caps">Ship to</div>@Model.ShipName, @Model.ShipPhone<br /><span class="small">@Model.ShipAddress, @Model.ShipCity</span></div>
        </div>
        <table class="table">
            <thead><tr><th>Item</th><th class="text-end">Unit</th><th class="text-end">Qty</th><th class="text-end">Amount</th></tr></thead>
            <tbody>
                @foreach (var i in Model.Items) { <tr><td>@i.ProductName <span class="small text-muted">@i.Sku</span></td><td class="text-end">@Fmt.Money(i.UnitPrice)</td><td class="text-end">@i.Quantity</td><td class="text-end">@Fmt.Money(i.LineTotal)</td></tr> }
            </tbody>
            <tfoot>
                <tr><td colspan="3" class="text-end">Subtotal</td><td class="text-end">@Fmt.Money(Model.SubTotal)</td></tr>
                @if (Model.DiscountAmount > 0) { <tr><td colspan="3" class="text-end">Discount @Model.CouponCode</td><td class="text-end">- @Fmt.Money(Model.DiscountAmount)</td></tr> }
                <tr><td colspan="3" class="text-end">Delivery</td><td class="text-end">@Fmt.Money(Model.ShippingFee)</td></tr>
                <tr><th colspan="3" class="text-end">Total</th><th class="text-end">@Fmt.Money(Model.TotalAmount)</th></tr>
            </tfoot>
        </table>
        <p class="small text-muted">Payment method: @Model.PaymentMethod. Thank you for shopping with @store.</p>
        <button class="btn btn-primary no-print" onclick="window.print()">Print</button>
    </div>
</body>
</html>
