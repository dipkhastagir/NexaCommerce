@model PurchaseOrder
@{ ViewData["Title"] = Model.PoNumber; }
<div class="page-head">
    <div><div class="crumbs"><a asp-action="Index">Purchase orders</a> / @Model.PoNumber</div><h1>@Model.PoNumber <span class="pill @Badge.Generic(Model.Status) fs-6 align-middle">@Model.Status</span></h1><div class="sub">@Model.SupplierName &middot; created by @Model.CreatedByName on @Fmt.Date(Model.OrderDate)</div></div>
    <div class="d-flex gap-2">
        @if (Model.Status == "Draft")
        {
            <form asp-action="Place" method="post"><input type="hidden" name="id" value="@Model.PurchaseOrderId" /><button class="btn btn-primary btn-sm" type="submit">Place with supplier</button></form>
        }
        @if (Model.Status is "Draft" or "Ordered")
        {
            <form asp-action="Receive" method="post" data-confirm="Mark all goods as received? Stock will increase immediately."><input type="hidden" name="id" value="@Model.PurchaseOrderId" /><button class="btn btn-ink btn-sm" type="submit"><i class="bi bi-box-arrow-in-down me-1"></i>Receive goods</button></form>
            <form asp-action="Cancel" method="post" data-confirm="Cancel this purchase order?"><input type="hidden" name="id" value="@Model.PurchaseOrderId" /><button class="btn btn-ghost btn-sm text-danger" type="submit">Cancel</button></form>
        }
    </div>
</div>
<div class="row g-3">
    <div class="col-xl-8">
        <div class="table-wrap">
            <table class="table-nx">
                <thead><tr><th>Product</th><th class="text-end">Quantity</th><th class="text-end">Unit cost</th><th class="text-end">Line total</th></tr></thead>
                <tbody>
                    @foreach (var i in Model.Items)
                    {
                        <tr><td><a asp-controller="Products" asp-action="Details" asp-route-id="@i.ProductId" class="fw-semibold">@i.ProductName</a> <span class="small text-muted">@i.Sku</span></td><td class="text-end tabular">@i.Quantity</td><td class="text-end tabular">@Fmt.Money(i.UnitCost)</td><td class="text-end tabular">@Fmt.Money(i.LineTotal)</td></tr>
                    }
                    <tr><td colspan="3" class="text-end fw-bold">Total</td><td class="text-end tabular fw-bold">@Fmt.Money(Model.TotalAmount)</td></tr>
                </tbody>
            </table>
        </div>
    </div>
    <div class="col-xl-4">
        <div class="panel">
            <dl class="kv">
                <dt>Supplier</dt><dd><a asp-controller="Suppliers" asp-action="Details" asp-route-id="@Model.SupplierId">@Model.SupplierName</a></dd>
                <dt>Warehouse</dt><dd>@(Model.WarehouseName ?? "-")</dd>
                <dt>Expected</dt><dd>@Fmt.Date(Model.ExpectedDate)</dd>
                <dt>Received</dt><dd>@Fmt.Stamp(Model.ReceivedDate)</dd>
                <dt>Notes</dt><dd>@(Model.Notes ?? "-")</dd>
            </dl>
        </div>
    </div>
</div>
