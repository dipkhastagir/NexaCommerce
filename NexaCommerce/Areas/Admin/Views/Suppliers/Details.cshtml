@model Supplier
@{
    ViewData["Title"] = Model.Name;
    var products = (List<Product>)ViewBag.Products;
    var pos = (List<PurchaseOrder>)ViewBag.PurchaseOrders;
}
<div class="page-head">
    <div><div class="crumbs"><a asp-action="Index">Suppliers</a> / @Model.Name</div><h1>@Model.Name</h1><div class="sub">@Model.LeadTimeDays-day lead time &middot; since @Fmt.Date(Model.CreatedAt)</div></div>
    <div class="d-flex gap-2">
        <a class="btn btn-ghost btn-sm" asp-controller="PurchaseOrders" asp-action="Create" asp-route-supplierId="@Model.SupplierId" asp-route-fromReorder="true"><i class="bi bi-magic me-1"></i>Order from recommendations</a>
        <a class="btn btn-primary btn-sm" asp-action="Edit" asp-route-id="@Model.SupplierId"><i class="bi bi-pencil me-1"></i>Edit</a>
        <form asp-action="Delete" method="post" data-confirm="Delete this supplier?"><input type="hidden" name="id" value="@Model.SupplierId" /><button class="btn btn-ghost btn-sm text-danger" type="submit"><i class="bi bi-trash"></i></button></form>
    </div>
</div>
<div class="row g-3">
    <div class="col-xl-4">
        <div class="panel">
            <div class="panel-title">Contact</div>
            <dl class="kv">
                <dt>Person</dt><dd>@(Model.ContactPerson ?? "-")</dd>
                <dt>E-mail</dt><dd>@(Model.Email ?? "-")</dd>
                <dt>Phone</dt><dd>@(Model.Phone ?? "-")</dd>
                <dt>Address</dt><dd>@(Model.Address ?? "-")</dd>
                <dt>Status</dt><dd>@(Model.IsActive ? "Active" : "Inactive")</dd>
            </dl>
        </div>
    </div>
    <div class="col-xl-8">
        <div class="table-wrap mb-3">
            <div class="p-3 pb-2 fw-bold">Products supplied (@products.Count)</div>
            <table class="table-nx">
                <thead><tr><th>Product</th><th class="text-end">Cost</th><th class="text-end">Stock</th><th class="text-end">Reorder at</th></tr></thead>
                <tbody>
                    @foreach (var p in products)
                    {
                        <tr><td><a asp-controller="Products" asp-action="Details" asp-route-id="@p.ProductId">@p.Name</a> <span class="small text-muted">@p.Sku</span></td><td class="text-end tabular">@Fmt.Money(p.CostPrice)</td><td class="text-end tabular fw-bold @Badge.Stock(p.StockStatus)">@p.StockQuantity</td><td class="text-end tabular">@p.ReorderLevel</td></tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="table-wrap">
            <div class="p-3 pb-2 fw-bold">Purchase orders</div>
            <table class="table-nx">
                <thead><tr><th>PO</th><th>Date</th><th>Status</th><th class="text-end">Lines</th><th class="text-end">Total</th></tr></thead>
                <tbody>
                    @foreach (var po in pos)
                    {
                        <tr><td><a asp-controller="PurchaseOrders" asp-action="Details" asp-route-id="@po.PurchaseOrderId" class="fw-bold">@po.PoNumber</a></td><td class="small">@Fmt.Date(po.OrderDate)</td><td><span class="pill @Badge.Generic(po.Status)">@po.Status</span></td><td class="text-end">@po.ItemCount</td><td class="text-end tabular">@Fmt.Money(po.TotalAmount)</td></tr>
                    }
                </tbody>
            </table>
            @if (!pos.Any()) { <div class="empty py-3">No purchase orders yet.</div> }
        </div>
    </div>
</div>
