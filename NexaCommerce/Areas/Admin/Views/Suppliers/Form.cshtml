@model Supplier
@{ var editing = Model.SupplierId > 0; ViewData["Title"] = editing ? "Edit " + Model.Name : "New supplier"; }
<div class="page-head"><div><div class="crumbs"><a asp-action="Index">Suppliers</a> / @(editing ? Model.Name : "New")</div><h1>@ViewData["Title"]</h1></div></div>
<form asp-action="@(editing ? "Edit" : "Create")" asp-route-id="@(editing ? Model.SupplierId : (int?)null)" method="post" class="panel" style="max-width:820px">
    <input type="hidden" asp-for="SupplierId" />
    <div class="row g-3">
        <div class="col-md-8"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" /><span asp-validation-for="Name"></span></div>
        <div class="col-md-4"><label asp-for="LeadTimeDays" class="form-label"></label><input asp-for="LeadTimeDays" class="form-control" /><span asp-validation-for="LeadTimeDays"></span></div>
        <div class="col-md-4"><label asp-for="ContactPerson" class="form-label"></label><input asp-for="ContactPerson" class="form-control" /></div>
        <div class="col-md-4"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control" /><span asp-validation-for="Email"></span></div>
        <div class="col-md-4"><label asp-for="Phone" class="form-label"></label><input asp-for="Phone" class="form-control" /></div>
        <div class="col-12"><label asp-for="Address" class="form-label"></label><input asp-for="Address" class="form-control" /></div>
        <div class="col-12 form-check form-switch ms-2"><input asp-for="IsActive" class="form-check-input" /><label asp-for="IsActive" class="form-check-label"></label></div>
    </div>
    <div class="d-flex gap-2 mt-3"><button class="btn btn-primary" type="submit">Save supplier</button><a class="btn btn-ghost" asp-action="Index">Cancel</a></div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
