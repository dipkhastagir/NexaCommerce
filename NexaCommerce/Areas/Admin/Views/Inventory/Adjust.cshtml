@model StockAdjustVm
@{ ViewData["Title"] = "Adjust stock"; }
<div class="page-head"><div><div class="crumbs"><a asp-action="Index">Inventory</a> / @Model.Sku</div><h1>Adjust stock: @Model.ProductName</h1><div class="sub">Currently <b>@Model.CurrentStock</b> units on hand.</div></div></div>
<form asp-action="Adjust" method="post" class="panel" style="max-width:720px">
    <input type="hidden" asp-for="ProductId" />
    <div asp-validation-summary="ModelOnly" class="flash flash-error mb-3"></div>
    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="MovementType" class="form-label"></label>
            <select asp-for="MovementType" class="form-select">
                <option value="ADJUSTMENT">Adjustment (correction)</option>
                <option value="COUNT">Stock count difference</option>
                <option value="PURCHASE">Goods received (no PO)</option>
                <option value="RETURN">Customer return to stock</option>
                <option value="DAMAGE">Damaged / write-off</option>
            </select>
        </div>
        <div class="col-md-6"><label asp-for="Quantity" class="form-label"></label><input asp-for="Quantity" class="form-control" id="qty" /><span asp-validation-for="Quantity"></span><div class="small text-muted mt-1" id="after"></div></div>
        <div class="col-md-6"><label asp-for="WarehouseId" class="form-label"></label><select asp-for="WarehouseId" asp-items="Model.Warehouses" class="form-select"><option value="">Not specified</option></select></div>
        <div class="col-md-6"><label asp-for="Reference" class="form-label"></label><input asp-for="Reference" class="form-control" placeholder="Invoice, count sheet..." /></div>
        <div class="col-12"><label asp-for="Note" class="form-label"></label><input asp-for="Note" class="form-control" placeholder="Why is stock changing?" /><span asp-validation-for="Note"></span></div>
    </div>
    <div class="d-flex gap-2 mt-3"><button class="btn btn-primary" type="submit">Record adjustment</button><a class="btn btn-ghost" asp-action="Index">Cancel</a></div>
</form>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            const q = document.getElementById('qty'), a = document.getElementById('after'), cur = @Model.CurrentStock;
            function upd() { const v = parseInt(q.value || '0', 10); const n = cur + v; a.textContent = 'Balance after: ' + n; a.className = 'small mt-1 ' + (n < 0 ? 'text-danger' : 'text-muted'); }
            q.addEventListener('input', upd); upd();
        })();
    </script>
}
