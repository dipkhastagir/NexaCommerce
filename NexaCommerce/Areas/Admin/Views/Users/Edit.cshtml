@model UserFormVm
@{ ViewData["Title"] = "Edit " + Model.FullName; }
<div class="page-head"><div><div class="crumbs"><a asp-action="Index">Users</a> / @Model.Email</div><h1>@Model.FullName</h1></div></div>
<form asp-action="Edit" asp-route-id="@Model.UserId" method="post" class="panel" style="max-width:820px">
    <input type="hidden" asp-for="UserId" />
    <partial name="_UserForm" model="Model" />
    <div class="d-flex gap-2 mt-3"><button class="btn btn-primary" type="submit">Save user</button><a class="btn btn-ghost" asp-action="Index">Cancel</a></div>
</form>
